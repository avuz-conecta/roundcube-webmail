# ============================================
# Base image with PHP extensions and runtime packages
# Rebuild only when PHP version or extensions change
# ============================================
FROM php:8.2-fpm-alpine

ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions

RUN install-php-extensions \
  intl mbstring pdo pdo_mysql pdo_sqlite gd zip \
  openssl ldap redis

RUN apk add --no-cache \
  nginx supervisor sqlite ncurses-libs \
  curl bash

# stunnel: TLS terminator for Zoho 993 (imapproxy has no native implicit-SSL)
RUN apk add --no-cache stunnel

# up-imapproxy: not in Alpine repos — compile from pinned Debian source + official patches
# Patches (openssl-1.1, fix-ssl-types, fix-size_t-formatters, etc.) fix OpenSSL 3 / GCC 14 issues
# CFLAGS: -Wno-incompatible-pointer-types is a deliberate compat flag for 2017 C source under modern GCC; not a sloppy suppression
RUN apk add --no-cache --virtual .imapproxy-build \
      build-base autoconf automake openssl-dev ncurses-dev bzip2 xz curl \
  && curl -fsSL "https://deb.debian.org/debian/pool/main/u/up-imapproxy/up-imapproxy_1.2.8~svn20171105.orig.tar.bz2" \
       -o /tmp/imapproxy.tar.bz2 \
  && echo "2fa3d400227c791b94d7f1e04f5ead5c2165eece44c8b018cc94ed55bb9efdde  /tmp/imapproxy.tar.bz2" | sha256sum -c - \
  && curl -fsSL "https://deb.debian.org/debian/pool/main/u/up-imapproxy/up-imapproxy_1.2.8~svn20171105-2.1.debian.tar.xz" \
       -o /tmp/imapproxy-debian.tar.xz \
  && echo "c19e9ec6fcb9fec32716058e693a05cd30eb991415b0b7e718ab80d3354e59ab  /tmp/imapproxy-debian.tar.xz" | sha256sum -c - \
  && mkdir -p /tmp/imapproxy && tar -xjf /tmp/imapproxy.tar.bz2 -C /tmp/imapproxy --strip-components=1 \
  && mkdir -p /tmp/imapproxy-debian && tar -xJf /tmp/imapproxy-debian.tar.xz -C /tmp/imapproxy-debian --strip-components=1 \
  && cd /tmp/imapproxy \
  && while read -r p; do patch -p1 < "/tmp/imapproxy-debian/patches/$p" || exit 1; done \
       < /tmp/imapproxy-debian/patches/series \
  && autoreconf -fi \
  && ./configure CFLAGS="-O2 -std=gnu11 -Wno-incompatible-pointer-types" \
  && make \
  && cp bin/in.imapproxyd /usr/local/sbin/in.imapproxyd \
  && strip /usr/local/sbin/in.imapproxyd \
  && cd / && rm -rf /tmp/imapproxy /tmp/imapproxy.tar.bz2 /tmp/imapproxy-debian /tmp/imapproxy-debian.tar.xz \
  && apk del .imapproxy-build

RUN { \
  echo '[www]'; \
  echo 'user = www-data'; \
  echo 'group = www-data'; \
  echo 'listen = 127.0.0.1:9000'; \
  echo 'pm = dynamic'; \
  echo 'pm.max_children = 20'; \
  echo 'pm.start_servers = 5'; \
  echo 'pm.min_spare_servers = 2'; \
  echo 'pm.max_spare_servers = 8'; \
  echo 'pm.max_requests = 500'; \
  echo 'clear_env = no'; \
  } > /usr/local/etc/php-fpm.d/www.conf

RUN { \
  echo 'memory_limit=256M'; \
  echo 'upload_max_filesize=25M'; \
  echo 'post_max_size=25M'; \
  echo 'max_execution_time=120'; \
  echo 'date.timezone=UTC'; \
  echo 'expose_php=Off'; \
  } > /usr/local/etc/php/conf.d/roundcube.ini

RUN mkdir -p /var/log/supervisor /run/nginx /var/cache/nginx \
  && chown -R www-data:www-data /var/cache/nginx

WORKDIR /var/www/html
