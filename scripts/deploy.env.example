# Portainer CE API access for scripts/portainer-exec.sh and scripts/logs.sh.
# Copy to deploy.env (gitignored) and fill in real values.
# The token is a SECRET — it grants API access to your Portainer.
#
# Token: Portainer → My account → Access tokens → Add access token.
# No DNS? Use the host IP + Portainer's HTTPS port, e.g. https://10.0.0.5:9443
PORTAINER_URL=https://portainer.avuz.app
PORTAINER_TOKEN=ptr_replace_me
# Set to 1 if Portainer uses a self-signed cert (default on :9443, no real cert).
PORTAINER_INSECURE=0

# For production, copy to deploy.prod.env with a SEPARATE token and run:
#   PORTAINER_ENV_FILE=scripts/deploy.prod.env ./scripts/logs.sh <container>
