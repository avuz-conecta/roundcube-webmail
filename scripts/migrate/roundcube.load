LOAD DATABASE
     FROM sqlite://{{SRC}}
     INTO {{PG_DSN}}

 WITH data only, workers = 2, concurrency = 1, on error stop

 SET work_mem to '64MB', maintenance_work_mem to '128MB'

 INCLUDING ONLY TABLE NAMES LIKE 'users', 'identities', 'contacts',
      'contactgroups', 'contactgroupmembers', 'collected_addresses', 'responses';
